---
// «Доставка цветов по Курску» – 4 карточки с условиями донора, для главной и каталога.
import IconCards from './IconCards.astro';
import { DELIVERY_FROM, FREE_FROM } from '../lib/delivery';
// неразрывные пробелы: «4 000 ₽» и «от 4 000» не рвутся по строкам
const n = (x: number) => x.toLocaleString('ru-RU').replace(/\s/g, '\u00a0');
const R = '\u00a0₽';
---
<IconCards
  title="Доставка цветов по Курску"
  sub="Ежедневно с 10:00 до 00:00 – личной курьерской службой."
  action={{ label: 'Подробнее о доставке и оплате', href: '/delivery' }}
  items={[
    { ico: 'clock', title: 'За 60 минут', text: 'Доставим по Курску в течение 60 минут с момента оплаты. Удалённые районы – чуть дольше.' },
    { ico: 'ruble', title: `От ${n(DELIVERY_FROM)}${R}`, text: 'Стоимость рассчитывается индивидуально в зависимости от района доставки.' },
    { ico: 'truck', title: `Бесплатно от\u00a0${n(FREE_FROM)}${R}`, text: `При заказе от ${n(FREE_FROM)}${R} доставка по Курску бесплатная.` },
    { ico: 'gift', title: 'Подарки к заказу', text: 'К каждому заказу – открытка и средство по уходу за букетом.' },
  ]}
/>
