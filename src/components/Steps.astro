---
// Шаги работы карточками в ленту (корпоративный заказ).
import SectionHead from './SectionHead.astro';
import { img } from '../lib/img';
import { IconFlower } from '../islands/icons';
const { title, sub, items } = Astro.props as { title: string; sub?: string; items: { icon?: string; title: string; text: string }[] };
---
<section class="section">
  <div class="container"><SectionHead title={title} sub={sub} /></div>
  <ol class="st hscroll" style={`--n: ${items.length}`}>
    {items.map((i, n) => (
      <li class="st__card">
        {i.icon ? <img src={img(i.icon)} alt="" width="40" height="40" loading="lazy" /> : <span class="num-badge" aria-hidden="true">{n + 1}</span>}
        <h3 class="h3">{i.title}</h3>
        <p>{i.text}</p>
        <button type="button" class="btn btn--pink btn--sm" data-lead>Оставить заявку <IconFlower size={16} /></button>
      </li>
    ))}
  </ol>
</section>
<style>
  /* компьютер – все шаги в одну сетку по ширине контейнера; уже 1200px – лента с прокруткой и отступами по краям */
  .st { list-style: none; margin: 0 auto; padding: 0 var(--gutter); max-width: var(--container); display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 16px; overflow: visible; }
  .st__card { display: flex; flex-direction: column; gap: 14px; padding: 22px 20px 20px; border: 1px solid var(--mauve); border-radius: var(--radius-xl); min-height: 320px; min-width: 0; }
  .st__card img { width: 40px; height: 40px; margin-bottom: 26px; }
  .st__card p { font-size: 13px; flex: 1; }
  .st__card :global(.h3) { font-size: clamp(20px, 1.7vw, 24px); }
  .st__card :global(.btn) { width: 100%; padding: 0 12px; }
  @media (max-width: 1199px) {
    .st { --pad: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); display: flex; max-width: none; gap: 12px; padding: 0 var(--pad); scroll-padding-inline: var(--pad); overflow-x: auto; }
    .st::after { content: ''; flex: none; width: 1px; }
    .st__card { width: 260px; min-height: 290px; }
  }
  @media (max-width: 1023px) { .st { gap: 10px; } .st__card { width: 240px; min-height: 280px; } }
</style>
