---
// Контакты внизу страниц (вариант 3, выбран владельцем 23.11.2026): заголовок с кнопками, три плашки (телефон, адрес, часы)
// и широкая карта Яндекса через JS API – без рекламного баннера виджета.
import YaMap from './YaMap.astro';
import { SITE, SOCIALS } from '../lib/site';
import { u } from '../lib/url';
import { IconFlower, Social } from '../islands/icons';
import { icoSvg } from '../lib/icons';

const svg = (d: string) => `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const rows = [
  { ico: svg('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/>'), label: 'Телефон', value: SITE.phone, href: SITE.phoneHref },
  { ico: svg('<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>'), label: 'Адрес', value: `${SITE.city}, ${SITE.address}` },
  { ico: icoSvg('clock'), label: 'Режим работы', value: SITE.hours },
];
---
<section class="section container cc" id="contacts">
  <div class="cc__head">
    <h2 class="h2">Приезжайте или закажите доставку</h2>
    <div class="cc__btns">
      <a class="btn btn--mauve" href={u('/catalog')}>Выбрать букет <IconFlower /></a>
      {SOCIALS.map((s) => <a class="cc__soc" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Social id={s.id} size={18} /></a>)}
    </div>
  </div>
  <ul class="cc__cards">
    {rows.map((r) => (
      <li class="reveal">
        <span class="cc__ico" aria-hidden="true" set:html={r.ico} />
        <small>{r.label}</small>
        {r.href ? <a href={r.href}>{r.value}</a> : <b>{r.value}</b>}
      </li>
    ))}
  </ul>
  <div class="cc__map reveal"><YaMap /></div>
</section>
<style>
  .cc { display: grid; gap: 20px; }
  .cc__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 20px; }
  .cc__btns { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .cc__soc { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: var(--pink); color: var(--mauve); transition: background-color .2s, color .2s; }
  .cc__soc:hover { background: var(--mauve); color: var(--cream); }
  .cc__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cc__cards li { display: grid; gap: 6px; padding: 24px; border-radius: var(--radius-xl); background: var(--bg-soft); }
  .cc__ico { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 14px; border-radius: 50%; background: var(--mauve); color: var(--cream); }
  .cc__cards small { font-size: 13px; color: var(--muted); }
  .cc__cards b, .cc__cards a { font: 400 clamp(19px, 1.7vw, 24px)/1.25 var(--body-font); color: var(--ink); }
  .cc__map { height: 420px; border-radius: var(--radius-xl); overflow: hidden; }
  @media (max-width: 1023px) {
    .cc { gap: 10px; }
    .cc__head { flex-direction: column; align-items: flex-start; margin-bottom: 4px; gap: 16px; }
    .cc__btns { width: 100%; flex-wrap: nowrap; gap: 8px; }
    .cc__btns .btn { flex: 1; min-width: 0; padding: 0 10px; }
    .cc__soc { width: 48px; height: 48px; flex: none; }
    .cc__cards { grid-template-columns: 1fr; gap: 10px; }
    .cc__cards li { grid-template-columns: 48px 1fr; column-gap: 14px; row-gap: 2px; padding: 16px; border-radius: var(--radius-l); }
    .cc__ico { grid-row: span 2; margin: 0; }
    .cc__map { height: 300px; border-radius: var(--radius-l); }
  }
</style>
