---
// Четыре карточки «фото букета + круглая иконка на стыке + заголовок и текст» на бежевом фоне.
// Выбраны владельцем 23.11.2026 вместо текстовых IconCards («О компании», «Гарантии», «Каталог»).
import SectionHead from './SectionHead.astro';
import { img, srcset } from '../lib/img';
import { icoSvg, type Ico } from '../lib/icons';

const { title, sub, center = false, id, items } = Astro.props as {
  title?: string; sub?: string; center?: boolean; id?: string;
  items: { ico: Ico; title: string; text: string; image: string }[];
};
---
<section class="section container" id={id}>
  {title && <SectionHead title={title} sub={sub} center={center} />}
  <ul class="pc4">
    {items.map((i) => (
      <li class="pc4__card reveal">
        <span class="pc4__ph">
          <img src={img(i.image)} srcset={srcset(i.image)} sizes="(max-width: 1023px) 50vw, 25vw" alt="" loading="lazy" />
          <span class="pc4__ico" aria-hidden="true" set:html={icoSvg(i.ico)} />
        </span>
        <span class="pc4__txt">
          <h3 class="h3 pc4__title">{i.title}</h3>
          <p class="pc4__text">{i.text}</p>
        </span>
      </li>
    ))}
  </ul>
</section>
<style>
  .pc4 { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .pc4__card { display: flex; flex-direction: column; border-radius: var(--radius-xl); overflow: hidden; background: var(--bg-soft); }
  .pc4__ph { position: relative; flex: none; display: block; aspect-ratio: 4 / 3; }
  .pc4__ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pc4__ico { position: absolute; left: 20px; bottom: -24px; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; background: var(--mauve); color: var(--cream); box-shadow: 0 0 0 4px var(--bg-soft); }
  .pc4__txt { display: grid; align-content: start; gap: 10px; padding: 40px 24px 26px; }
  .pc4__title { font-size: clamp(21px, 1.8vw, 26px); }
  .pc4__text { font-size: 13.5px; line-height: 1.5; }
  @media (max-width: 1023px) {
    .pc4 { grid-template-columns: 1fr 1fr; gap: 10px; }
    .pc4__card { border-radius: var(--radius-l); }
    .pc4__ico { width: 40px; height: 40px; left: 12px; bottom: -20px; }
    .pc4__ico :global(svg) { width: 19px; height: 19px; }
    .pc4__txt { padding: 30px 14px 16px; gap: 6px; }
    .pc4__title { font-size: 19px; }
    .pc4__text { font-size: 12.5px; }
  }
</style>
