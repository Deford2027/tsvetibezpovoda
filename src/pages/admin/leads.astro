---
/** Админка → Заявки (остров Leads; доска – эталон ALEX KROWN / EV, перенос с Milovini 7f97294).
    Данные – из приёмника на сервере (deploy/stend/leads.py), категория товара – по названию из каталога. */
import Admin from '../../layouts/Admin.astro';
import Leads from '../../islands/admin/Leads';
import { products } from '../../lib/catalog';
import { CATALOGS } from '../../lib/site';
const cats = Object.fromEntries(products.map((p) => [p.title, CATALOGS.find((c) => p.parts.includes(c.part))?.title || '']));
const lead: string = import.meta.env.PUBLIC_LEAD_URL || '';
const remote = lead.startsWith('http') ? new URL('/admin/leads/', lead).href : '';
---
<Admin title="Заявки" active="leads">
  <Leads client:load cats={cats} remote={remote} />
</Admin>
