---
// Реквизиты – как на /rekvizity донора: юридический адрес и телефон там не заполнены.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../lib/site';
---
<Base title={`Реквизиты – ${SITE.name}`} description={`Реквизиты цветочного салона «${SITE.name}»: ${SITE.owner}, ИНН ${SITE.inn}, ОГРНИП ${SITE.ogrnip}.`}>
  <article class="container rq">
    <Crumbs items={[{ label: 'Главная', href: '/' }, { label: 'Реквизиты' }]} />
    <h1 class="h1">Реквизиты</h1>
    <dl>
      <div><dt>Продавец</dt><dd>{SITE.owner}</dd></div>
      <div><dt>ИНН / ОГРНИП</dt><dd>{SITE.inn} / {SITE.ogrnip}</dd></div>
      <div><dt>Адрес студии</dt><dd>{SITE.city}, {SITE.address}</dd></div>
      <div><dt>Телефон</dt><dd><a href={SITE.phoneHref}>{SITE.phone}</a></dd></div>
    </dl>
  </article>
</Base>
<style>
  .rq { padding-top: 24px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  dl { margin: 16px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  dl > div { display: grid; align-content: start; gap: 8px; padding: 28px; border-radius: var(--radius-xl); background: var(--bg-soft); }
  dt { font-size: 13px; color: var(--muted); }
  dd { margin: 0; font-size: clamp(18px, 1.7vw, 24px); line-height: 1.3; color: var(--ink); overflow-wrap: anywhere; }
  @media (max-width: 1023px) { dl { grid-template-columns: minmax(0, 1fr); gap: 10px; } dl > div { padding: 18px 16px; border-radius: var(--radius-l); } }
</style>
