---
// ВРЕМЕННАЯ страница: 4 варианта текстовых карточек (IconCards без иконок и фото) на выбор владельцу.
// Блок встречается на «О компании», «Гарантиях» и в «Каталоге». После выбора – перенести в IconCards.astro, страницу удалить.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { img } from '../lib/img';
import { photo } from '../lib/catalog';

const items = [
  { title: 'Помощь с выбором', text: 'Подскажем букет под получателя, повод и бюджет – по телефону или в мессенджере.', ico: 'chat', ph: photo(31) },
  { title: 'Своя курьерская служба', text: 'Доставляем по Курску в течение 60 минут с момента оплаты.', ico: 'clock', ph: photo(46) },
  { title: 'Подарки к заказу', text: 'К каждому букету – открытка и средство по уходу.', ico: 'gift', ph: photo(85) },
  { title: 'Удобная оплата', text: 'Переводом после подтверждения заказа или наличными при самовывозе.', ico: 'card', ph: photo(57) },
];
const ICONS: Record<string, string> = {
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8S10.5 4 8 4a2 2 0 0 0 0 4h4ZM12 8s1.5-4 4-4a2 2 0 0 1 0 4h-4Z"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19M6.5 15h4"/>',
};
const icon = (k: string, s = 26) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>`;
const head = { title: 'От выбора цветов до момента вручения', sub: 'Для нас заказ – это не только готовый букет. Важно, чтобы вы были уверены в результате на каждом этапе', center: true };
---
<Base title="Варианты блока преимуществ" noindex>
  <section class="section container">
    <h1 class="h2">Варианты блока «От выбора цветов до момента вручения»</h1>
    <p class="vb-note">Временная страница для выбора. Этот же блок есть на «Гарантиях» и в «Каталоге» – выбранный вариант встанет во все три места.</p>
  </section>

  <section class="section container">
    <p class="vb-tag">Вариант 1 · Бежевые карточки с иконками</p>
    <SectionHead {...head} />
    <ul class="b1">{items.map((i) => <li><span class="b1__ico" set:html={icon(i.ico)} /><h3 class="h3">{i.title}</h3><p>{i.text}</p></li>)}</ul>
  </section>

  <section class="section container">
    <p class="vb-tag">Вариант 2 · Оливковая полоса</p>
    <div class="b2 pink-card">
      <div class="b2__head"><h2 class="h2">{head.title}</h2><p>{head.sub}</p></div>
      <ul class="b2__list">{items.map((i) => <li><span class="b2__ico" set:html={icon(i.ico, 24)} /><h3 class="h3">{i.title}</h3><p>{i.text}</p></li>)}</ul>
    </div>
  </section>

  <section class="section container">
    <p class="vb-tag">Вариант 3 · Номера этапов</p>
    <SectionHead {...head} />
    <ol class="b3">{items.map((i, n) => <li><span class="b3__num">0{n + 1}</span><h3 class="h3">{i.title}</h3><p>{i.text}</p></li>)}</ol>
  </section>

  <section class="section container">
    <p class="vb-tag">Вариант 4 · Карточки с фото</p>
    <SectionHead {...head} />
    <ul class="b4">{items.map((i) => <li><span class="b4__ph"><img src={img(i.ph)} alt="" loading="lazy" /><span class="b4__ico" set:html={icon(i.ico, 22)} /></span><span class="b4__txt"><h3 class="h3">{i.title}</h3><p>{i.text}</p></span></li>)}</ul>
  </section>
</Base>

<style>
  .vb-note { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .vb-tag { display: inline-block; margin-bottom: 20px; padding: 8px 14px; border-radius: 999px; background: var(--mauve); color: var(--cream); font: 600 13px/1 var(--body-font); }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  .h3 { font-size: clamp(21px, 1.8vw, 26px); }
  p { font-size: 13.5px; line-height: 1.5; }

  /* 1 */
  .b1 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .b1 li { display: grid; align-content: start; gap: 12px; padding: 28px; border-radius: var(--radius-xl); background: var(--bg-soft); }
  .b1__ico { width: 56px; height: 56px; display: grid; place-items: center; margin-bottom: 18px; border-radius: 50%; background: var(--mauve); color: var(--cream); }

  /* 2 */
  .b2 { padding: 56px; border-radius: var(--radius-xl); display: grid; gap: 44px; }
  .b2__head { position: relative; z-index: 1; display: grid; gap: 14px; justify-items: center; text-align: center; max-width: 760px; margin: 0 auto; }
  .b2__head p { color: var(--cream); opacity: .85; font-size: 14px; }
  .b2__list { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); }
  .b2__list li { display: grid; align-content: start; gap: 12px; padding: 0 28px; color: var(--cream); }
  .b2__list li + li { border-left: 1px solid rgba(243, 238, 220, .22); }
  .b2__list li:first-child { padding-left: 0; }
  .b2__list li:last-child { padding-right: 0; }
  .b2__list p { opacity: .85; }
  .b2__ico { width: 52px; height: 52px; display: grid; place-items: center; margin-bottom: 10px; border-radius: 50%; background: var(--cream); color: var(--mauve); }

  /* 3 */
  .b3 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .b3 li { position: relative; display: grid; align-content: start; gap: 12px; padding-top: 28px; border-top: 2px solid var(--mauve); }
  .b3__num { font: 400 64px/1 var(--head-font); color: var(--pink-deep); margin-bottom: 12px; }

  /* 4 */
  .b4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .b4 li { display: flex; flex-direction: column; border-radius: var(--radius-xl); overflow: hidden; background: var(--bg-soft); }
  .b4__ph { position: relative; display: block; aspect-ratio: 4 / 3; }
  .b4__ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .b4__ph { flex: none; }
  .b4__ico { position: absolute; left: 20px; bottom: -24px; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; background: var(--mauve); color: var(--cream); box-shadow: 0 0 0 4px var(--bg-soft); }
  .b4__txt { display: grid; gap: 10px; padding: 40px 24px 26px; }

  @media (max-width: 1023px) {
    .h3 { font-size: 19px; }
    p { font-size: 12.5px; }
    .b1, .b3, .b4 { grid-template-columns: 1fr 1fr; gap: 10px; }
    .b1 li { padding: 16px; gap: 8px; border-radius: var(--radius-l); }
    .b1__ico { width: 44px; height: 44px; margin-bottom: 8px; }
    .b2 { padding: 28px 20px; gap: 24px; }
    .b2__list { grid-template-columns: 1fr; gap: 18px; }
    .b2__list li { grid-template-columns: 44px 1fr; column-gap: 14px; row-gap: 4px; padding: 0; }
    .b2__list li + li { border-left: 0; border-top: 1px solid rgba(243, 238, 220, .22); padding-top: 18px; }
    .b2__ico { width: 44px; height: 44px; margin: 0; grid-row: span 2; }
    .b3 { gap: 24px 14px; }
    .b3__num { font-size: 44px; margin-bottom: 4px; }
    .b3 li { padding-top: 16px; gap: 8px; }
    .b4__ico { width: 40px; height: 40px; left: 12px; bottom: -20px; }
    .b4__txt { padding: 30px 14px 16px; gap: 6px; }
  }
</style>
