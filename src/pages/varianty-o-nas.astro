---
// ВРЕМЕННАЯ страница: 4 варианта блока «Цветы, к которым относимся с вниманием» (О компании) на выбор владельцу.
// После выбора – перенести вариант на o-kompanii.astro, страницу удалить.
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { img, srcset } from '../lib/img';
import { photo } from '../lib/catalog';
import { SITE } from '../lib/site';

const title = 'Цветы, к которым относимся с вниманием';
const p1 = `«${SITE.name}» – цветочный салон в Курске. Наша студия – на ул. Ленина, 74, открыта ежедневно с 10:00 до 22:00.`;
const p2 = 'В каталоге – сборные букеты, монобукеты, композиции и премиум-букеты. Хиты и акции собраны в отдельные разделы, чтобы выбрать было проще.';
const facts = [
  { big: 'ул. Ленина, 74', small: 'наша студия в Курске' },
  { big: '10:00–22:00', small: 'ежедневно, без выходных' },
  { big: '60 минут', small: 'доставка по Курску' },
  { big: '5,0', small: 'рейтинг на Яндекс Картах' },
];
const A = photo(47), B = photo(64), C = photo(66), D = photo(48), E = photo(45);
const pic = (src: string) => ({ src: img(src), srcset: srcset(src), sizes: '(max-width: 1023px) 100vw, 50vw', alt: '', loading: 'lazy' as const });
---
<Base title="Варианты блока о студии" noindex>
  <section class="section container">
    <h1 class="h2">Варианты блока «Цветы, к которым относимся с вниманием»</h1>
    <p class="vo-note">Временная страница для выбора. Фото во всех вариантах другие – из снимков в студии.</p>
  </section>

  <!-- 1: фото на всю ширину, текст на карточке поверх -->
  <section class="section container">
    <p class="vo-tag">Вариант 1 · Широкое фото и карточка поверх</p>
    <div class="o1">
      <div class="o1__photo"><img {...pic(A)} /></div>
      <div class="o1__card">
        <h2 class="h2">{title}</h2>
        <p>{p1}</p><p>{p2}</p>
        <div class="vo-btns"><Btn label="Выбрать букет" href="/catalog" variant="pink" flower /><Btn label="Помогите выбрать" lead variant="outline" /></div>
      </div>
    </div>
  </section>

  <!-- 2: текст + коллаж из трёх фото -->
  <section class="section container">
    <p class="vo-tag">Вариант 2 · Текст и коллаж из трёх фото</p>
    <div class="o2">
      <div class="o2__body">
        <h2 class="h2">{title}</h2>
        <p>{p1}</p><p>{p2}</p>
        <div class="vo-btns"><Btn label="Выбрать букет" href="/catalog" variant="pink" flower /><Btn label="Помогите выбрать" lead variant="outline" /></div>
      </div>
      <div class="o2__grid">
        <div class="o2__big"><img {...pic(B)} /></div>
        <div><img {...pic(C)} /></div>
        <div><img {...pic(D)} /></div>
      </div>
    </div>
  </section>

  <!-- 3: оливковая карточка с фактами и фото внутри -->
  <section class="section container">
    <p class="vo-tag">Вариант 3 · Оливковая карточка с фактами</p>
    <div class="o3 pink-card">
      <div class="o3__body">
        <h2 class="h2">{title}</h2>
        <p>{p1}</p><p>{p2}</p>
        <ul class="o3__facts">{facts.map((f) => <li><b>{f.big}</b><span>{f.small}</span></li>)}</ul>
        <div class="vo-btns"><Btn label="Выбрать букет" href="/catalog" variant="white" flower /><Btn label="Помогите выбрать" lead variant="outline" /></div>
      </div>
      <div class="o3__photo"><img {...pic(A)} /></div>
    </div>
  </section>

  <!-- 4: заголовок по центру, ниже лента фото и факты -->
  <section class="section container">
    <p class="vo-tag">Вариант 4 · Заголовок по центру, лента фото и факты</p>
    <div class="o4">
      <div class="o4__head">
        <h2 class="h2">{title}</h2>
        <p>{p1} {p2}</p>
      </div>
      <div class="o4__strip">
        <div><img {...pic(D)} /></div>
        <div class="o4__mid"><img {...pic(B)} /></div>
        <div><img {...pic(E)} /></div>
      </div>
      <ul class="o4__facts">{facts.map((f) => <li><b>{f.big}</b><span>{f.small}</span></li>)}</ul>
      <div class="vo-btns o4__btns"><Btn label="Выбрать букет" href="/catalog" variant="pink" flower /><Btn label="Помогите выбрать" lead variant="outline" /></div>
    </div>
  </section>
</Base>

<style>
  .vo-note { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .vo-tag { display: inline-block; margin-bottom: 20px; padding: 8px 14px; border-radius: 999px; background: var(--mauve); color: var(--cream); font: 600 13px/1 var(--body-font); }
  .vo-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* 1 */
  .o1 { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; }
  .o1__photo { grid-column: 1 / 9; grid-row: 1; height: 600px; border-radius: var(--radius-xl); overflow: hidden; }
  .o1__photo img { object-position: center 20%; }
  .o1__card { grid-column: 7 / 13; grid-row: 1; z-index: 1; display: grid; gap: 18px; padding: 48px 44px; border-radius: var(--radius-xl); background: var(--bg-soft); font-size: 14px; box-shadow: var(--shadow); }

  /* 2 */
  .o2 { display: grid; grid-template-columns: 5fr 7fr; gap: 60px; align-items: center; }
  .o2__body { display: grid; gap: 18px; font-size: 14px; max-width: 520px; }
  .o2__grid { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr 1fr; gap: 16px; height: 600px; }
  .o2__grid > div { border-radius: var(--radius-xl); overflow: hidden; }
  .o2__big { grid-row: span 2; }

  /* 3 */
  .o3 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 20px; border-radius: var(--radius-xl); }
  .o3__body { position: relative; z-index: 1; display: grid; gap: 18px; align-content: center; padding: 36px 36px 36px 40px; font-size: 14px; color: var(--cream); }
  .o3__facts { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .o3__facts li { display: grid; gap: 4px; padding: 16px 18px; border-radius: var(--radius-l); background: rgba(243, 238, 220, .1); }
  .o3__facts b { font: 400 22px/1.1 var(--head-font); color: var(--cream); }
  .o3__facts span { font-size: 12.5px; opacity: .8; }
  .o3__photo { position: relative; z-index: 1; min-height: 600px; border-radius: var(--radius-l); overflow: hidden; }

  /* 4 */
  .o4 { display: grid; gap: 32px; }
  .o4__head { display: grid; gap: 18px; justify-items: center; text-align: center; max-width: 820px; margin: 0 auto; font-size: 15px; }
  .o4__strip { display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: 20px; height: 480px; }
  .o4__strip > div { border-radius: var(--radius-xl); overflow: hidden; }
  .o4__mid { transform: translateY(-20px); }
  .o4__facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .o4__facts li { display: grid; gap: 6px; padding: 22px 24px; border-radius: var(--radius-l); background: var(--bg-soft); }
  .o4__facts b { font: 400 26px/1.1 var(--head-font); color: var(--mauve); }
  .o4__facts span { font-size: 13px; color: var(--muted); }
  .o4__btns { justify-content: center; margin: 0; }

  @media (max-width: 1023px) {
    .vo-btns { flex-direction: column; }
    .vo-btns :global(.btn) { width: 100%; }
    .o1 { display: block; }
    .o1__photo { height: 320px; }
    .o1__card { margin: -48px 12px 0; position: relative; padding: 24px 20px; gap: 14px; }
    .o2 { grid-template-columns: 1fr; gap: 24px; }
    .o2__grid { height: 360px; gap: 10px; order: -1; }
    .o3 { grid-template-columns: 1fr; padding: 10px; gap: 10px; }
    .o3__photo { min-height: 300px; order: -1; }
    .o3__body { padding: 16px 12px 20px; gap: 14px; }
    .o3__facts b { font-size: 18px; }
    .o4 { gap: 20px; }
    .o4__strip { grid-template-columns: 1fr 1fr; height: 300px; gap: 10px; }
    .o4__strip > div:last-child { display: none; }
    .o4__mid { transform: none; }
    .o4__facts { grid-template-columns: 1fr 1fr; gap: 10px; }
    .o4__facts li { padding: 14px 16px; }
    .o4__facts b { font-size: 19px; }
  }
</style>
