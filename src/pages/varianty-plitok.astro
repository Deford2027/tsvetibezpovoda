---
// ВРЕМЕННАЯ страница: 4 варианта блока «Цветы для задач вашей компании» (CategoryTiles) на выбор владельцу.
// После выбора – перенести вариант в CategoryTiles.astro, страницу удалить.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { u } from '../lib/url';
import { CATEGORY_TILES } from '../lib/site';
import { products, inPart } from '../lib/catalog';

// у каждой плитки своё фото: берём первый товар раздела, чьё фото ещё не занято
const used = new Set<string>();
const items = CATEGORY_TILES.slice(0, 8).map((c) => {
  const inCat = products.filter((p) => inPart(p, c.part) && p.images.length);
  const pick = inCat.find((p) => !used.has(p.images[0])) ?? inCat[0];
  const image = pick?.images[0] ?? '';
  used.add(image);
  return { ...c, image: u(image + '-480.webp'), count: inCat.length };
});
const word = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'букет' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'букета' : 'букетов');
const sub = 'Заказывайте букеты и композиции для сотрудников, клиентов, партнёров и корпоративных событий. В каталоге доступны:';
const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title="Варианты плиток разделов" noindex>
  <section class="section container">
    <h1 class="h2">Варианты блока «Цветы для задач вашей компании»</h1>
    <p class="vp-note">Временная страница для выбора. Во всех вариантах у каждой плитки своё фото и количество букетов в разделе.</p>
  </section>

  <!-- Вариант 1 -->
  <section class="section container">
    <p class="vp-tag">Вариант 1 · Фото во всю плитку</p>
    <SectionHead title="Цветы для задач вашей компании" sub={sub} />
    <div class="v1">
      {items.map((c) => (
        <a class="v1__tile" href={u(c.href)}>
          <img src={c.image} alt="" loading="lazy" />
          <span class="v1__body"><span class="v1__title">{c.title}</span><span class="v1__count">{c.count} {word(c.count)}</span></span>
          <span class="v1__arrow" set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- Вариант 2 -->
  <section class="section container">
    <p class="vp-tag">Вариант 2 · Бежевая карточка с фото внутри</p>
    <SectionHead title="Цветы для задач вашей компании" sub={sub} />
    <div class="v2">
      {items.map((c) => (
        <a class="v2__tile" href={u(c.href)}>
          <span class="v2__head"><span><span class="v2__title">{c.title}</span><span class="v2__count">{c.count} {word(c.count)}</span></span><span class="v2__arrow" set:html={arrow} /></span>
          <span class="v2__photo"><img src={c.image} alt="" loading="lazy" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Вариант 3 -->
  <section class="section container">
    <p class="vp-tag">Вариант 3 · Мозаика с главной плиткой</p>
    <SectionHead title="Цветы для задач вашей компании" sub={sub} />
    <div class="v3">
      {items.map((c, i) => (
        <a class:list={['v1__tile v3__tile', `v3__t${i + 1}`]} href={u(c.href)}>
          <img src={c.image} alt="" loading="lazy" />
          <span class="v1__body"><span class="v1__title">{c.title}</span><span class="v1__count">{c.count} {word(c.count)}</span></span>
          <span class="v1__arrow" set:html={arrow} />
        </a>
      ))}
    </div>
  </section>

  <!-- Вариант 4 -->
  <section class="section container">
    <p class="vp-tag">Вариант 4 · Компактные карточки в строку</p>
    <SectionHead title="Цветы для задач вашей компании" sub={sub} />
    <div class="v4">
      {items.map((c) => (
        <a class="v4__tile" href={u(c.href)}>
          <img src={c.image} alt="" loading="lazy" />
          <span class="v4__text"><span class="v4__title">{c.title}</span><span class="v4__count">{c.count} {word(c.count)}</span></span>
          <span class="v4__arrow" set:html={arrow} />
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .vp-note { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .vp-tag { display: inline-block; margin-bottom: 20px; padding: 8px 14px; border-radius: 999px; background: var(--mauve); color: var(--cream); font: 600 13px/1 var(--body-font); }

  /* 1 и 3: фото на всю плитку, подпись на затемнении */
  .v1 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .v1__tile { position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius-xl); overflow: hidden; background: var(--bg-soft); isolation: isolate; }
  .v1__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .v1__tile::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgba(40, 54, 24, .78)); }
  .v1__tile:hover img { transform: scale(1.05); }
  .v1__body { position: absolute; left: 24px; right: 76px; bottom: 22px; z-index: 1; display: grid; gap: 6px; color: #fff; }
  .v1__title { font: 400 clamp(22px, 2vw, 30px)/1.05 var(--head-font); }
  .v1__count { font-size: 13px; opacity: .85; }
  .v1__arrow { position: absolute; right: 20px; bottom: 22px; z-index: 1; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--cream); color: var(--mauve); transition: transform .25s var(--ease); }
  .v1__tile:hover .v1__arrow { transform: translateX(3px); }

  /* 2: бежевая карточка, фото со своим скруглением */
  .v2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .v2__tile { display: flex; flex-direction: column; gap: 18px; padding: 12px; border-radius: var(--radius-xl); background: var(--bg-soft); transition: background-color .25s; }
  .v2__tile:hover { background: var(--pink); }
  .v2__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 12px 10px 0 12px; }
  .v2__head > span:first-child { display: grid; gap: 6px; }
  .v2__title { font: 400 clamp(22px, 2vw, 28px)/1.05 var(--head-font); color: var(--mauve); }
  .v2__count { font-size: 13px; color: var(--muted); }
  .v2__arrow { flex: none; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--mauve); color: var(--cream); transition: transform .25s var(--ease); }
  .v2__tile:hover .v2__arrow { transform: translateX(3px); }
  .v2__photo { display: block; aspect-ratio: 1; border-radius: var(--radius-l); overflow: hidden; }
  .v2__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .v2__tile:hover .v2__photo img { transform: scale(1.05); }

  /* 3: мозаика – большая плитка 2×2, внизу одна широкая */
  .v3 { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 280px; gap: 20px; }
  .v3__tile { aspect-ratio: auto; }
  .v3__t1 { grid-column: span 2; grid-row: span 2; }
  .v3__t1 .v1__title { font-size: clamp(30px, 3vw, 44px); }
  .v3__t6 { grid-column: span 2; }

  /* 4: компактные горизонтальные карточки */
  .v4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .v4__tile { display: flex; align-items: center; gap: 16px; padding: 10px 18px 10px 10px; border-radius: var(--radius-l); background: var(--bg-soft); transition: background-color .25s; }
  .v4__tile:hover { background: var(--pink); }
  .v4__tile img { flex: none; width: 84px; height: 100px; object-fit: cover; border-radius: 12px; }
  .v4__text { flex: 1; min-width: 0; display: grid; gap: 6px; }
  .v4__title { font: 400 22px/1.1 var(--head-font); color: var(--mauve); }
  .v4__count { font-size: 13px; color: var(--muted); }
  .v4__arrow { flex: none; color: var(--mauve); transition: transform .25s var(--ease); }
  .v4__tile:hover .v4__arrow { transform: translateX(3px); }

  @media (max-width: 1023px) {
    .v1, .v2 { grid-template-columns: 1fr 1fr; gap: 10px; }
    .v1__body { left: 14px; right: 14px; bottom: 14px; gap: 4px; }
    .v1__title { font-size: 19px; }
    .v1__count { font-size: 12px; }
    .v1__arrow { display: none; }
    .v2__tile { padding: 8px; gap: 10px; }
    .v2__head { padding: 6px 4px 0 6px; }
    .v2__title { font-size: 18px; }
    .v2__arrow { display: none; }
    .v3 { grid-template-columns: 1fr 1fr; grid-auto-rows: 200px; gap: 10px; }
    .v3__t1 { grid-row: span 1; }
    .v3__t6 { grid-column: span 1; }
    .v3__t8 { grid-column: span 2; }
    .v3__t1 .v1__title { font-size: 24px; }
    .v4 { grid-template-columns: 1fr; gap: 8px; }
    .v4__tile img { width: 64px; height: 76px; }
    .v4__title { font-size: 20px; }
  }
</style>
